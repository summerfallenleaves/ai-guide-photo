# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格表示换行,不能删
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4

[*.{gradle,properties}]
indent_size = 4
