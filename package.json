{
  "name": "ai-guide-photograph",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "private": true,
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.31",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "server": "npm --prefix server start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:android": ".toolchain/build.sh :app:test",
    "test:all": "npm run test && npm run test:android"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/data/**/*.ts",
      "src/infra/**/*.ts",
      "!src/infra/ai/index.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "text"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "description": "AI 摄影助手:取景时实时给出可执行的调整建议,拍后点评并给出可一键应用的拍摄参数。Android + 自研 Camera2 + DeepSeek。",
  "license": "MIT",
  "author": "summerfallenleaves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summerfallenleaves/ai-guide-photo.git"
  },
  "homepage": "https://github.com/summerfallenleaves/ai-guide-photo#readme",
  "bugs": {
    "url": "https://github.com/summerfallenleaves/ai-guide-photo/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "android",
    "camera2",
    "ai",
    "deepseek",
    "photography",
    "camera"
  ]
}
