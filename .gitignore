# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
server/.env

# 本地依赖缓存(沙箱环境把 HOME 指到了工作区)
.home/
.npm-cache/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# 手动下载的安装包(体积大,不入库)
assets/apk/

# 本地 Android 构建工具链(约 2GB,不入库)
.toolchain/

# 本地 Expo Module 的构建产物不可入库
/modules/*/android/build/

# 第三方 agent skills(本地安装,不入库)
/agent/
/.agents/

# 本地 AI 工具配置(符号链接指向 .agents/,克隆后会断)
/.claude/
/skills-lock.json

# 发布日志
.release.log
